# .env.example - contains no real credentials.
# Copy this file to .env and edit .env only. .env is ignored by git.

# Local model through Ollama (default, free, offline)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional free cloud tiers. Leave the placeholders to run with the local model only.
GEMINI_API_KEY=YOUR_LOCAL_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=YOUR_LOCAL_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b

# Routing policy: local_only, cheap_first, or strong_only
ASKDB_POLICY=local_only

# Where history, saved questions, and usage are stored. Defaults to ~/.askdb
# ASKDB_HOME=
